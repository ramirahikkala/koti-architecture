specification {
  element actor
  element system
  element container
  element component
  element external
}

model {
  rami = actor 'Rami' 'Ylläpitää ja kehittää koko settiä'
  perhe = actor 'Perheenjäsen' 'Käyttää Home Assistant -näkymää, vastaanottaa hälytyksiä'

  wilma = external 'Wilma' 'Koulun asiointijärjestelmä'
  anthropic = external 'Anthropic Claude API' 'LLM-poiminta'
  spotHinta = external 'Spot-Hinta API' 'Sähkön pörssihinta'
  telegram = external 'Telegram Bot API' 'Suunniteltu ilmoituskanava'

  koti = system 'koti' 'Kotiautomaatioalusta' {

    heating = container 'Lämmityksen ohjain' 'Hintaohjattu kahden tason lämmityksen ohjaus' {
      technology 'Python'

      settings = component 'Settings' 'Ympäristöasetukset (.env)'
      zones = component 'Zones' 'zones.yaml: huoneet, kattila, kynnysarvot'
      controlCycle = component 'Control cycle' '15 min sykli: hae hinta+lämpötilat, aja strategiat, julkaise'
      strategies = component 'Strategies' 'onoff/trv-huonekohtainen ohjauslogiikka'
      publisher = component 'MQTT publisher' 'HA discovery, actuointi, sensorien luku'

      settings -> controlCycle 'konfiguroi'
      controlCycle -> zones 'lukee'
      controlCycle -> strategies 'ajaa'
      controlCycle -> publisher 'julkaisee tulokset, lukee sensorit'
    }

    wilmaService = container 'Wilma-muistutuspalvelu' 'Poimii deadlinet viesteistä ja kokeista, ajoittaa muistutukset' {
      technology 'Python'

      wilmaClient = component 'Wilma client' 'Kirjautuminen, roolinvaihto per lapsi'
      messages = component 'Messages' 'Hakee ja purkaa uudet viestit'
      exams = component 'Exams' 'Hakee koeaikataulun (spike)'
      extraction = component 'LLM-poiminta' 'Anthropic-kutsu: tunnistaa deadlinet/päivitykset viesteistä'
      rules = component 'Reminder rules' 'Deterministinen: milloin muistutukset ajoitetaan'
      storage = component 'Storage' 'SQLite: nähdyt viestit/kokeet, eventit, muistutukset'
      reminderEngine = component 'Reminder engine' 'Tarkistaa erääntyneet muistutukset ja laukaisee ne'
      publisher = component 'MQTT publisher' 'HA event-entiteetit + retained today-topic'

      wilmaClient -> messages
      wilmaClient -> exams
      messages -> extraction
      extraction -> rules
      exams -> rules
      rules -> storage
      reminderEngine -> storage 'lukee erääntyneet'
      reminderEngine -> publisher 'laukaisee'
    }

    mqtt = container 'MQTT-broker' 'Julkaisu/tilaus-väylä, koko systeemin substraatti' {
      technology 'Mosquitto'
    }

    ha = container 'Home Assistant' 'Kojelauta, historia, automaatiot'

    gateway = container 'BLE→MQTT-yhdyskäytävät' 'Siltaa RuuviTag/Shelly BLU -anturit MQTT:hen' {
      technology 'ESPHome'
    }

    desk = container 'Desk display' 'Näyttää lämpötilat, kattilan tilan, päivän muistutukset' {
      technology 'T-Display-S3'
    }

    shelly = container 'Shelly-releet/TRV:t' 'Lämmityksen toimilaitteet' {
      technology 'Natiivi MQTT'
    }
  }

  perhe -> koti.ha 'katsoo kojelautaa, saa hälytyksiä'
  perhe -> telegram 'saa hälytyksiä (suunniteltu)'
  rami -> koti 'ylläpitää'

  koti.heating.publisher -> koti.mqtt
  koti.wilmaService.publisher -> koti.mqtt
  koti.gateway -> koti.mqtt
  koti.shelly -> koti.mqtt
  koti.desk -> koti.mqtt 'lukee retained-topicit suoraan'
  koti.mqtt -> koti.ha

  koti.ha -> telegram 'automaatio (myöh.)'

  koti.wilmaService.wilmaClient -> wilma 'evästesessio'
  koti.wilmaService.extraction -> anthropic
  koti.heating.controlCycle -> spotHinta
}
