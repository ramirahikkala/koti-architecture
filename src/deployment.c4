specification {
  deploymentNode koti {
    title 'Koti'
  }
  deploymentNode vm {
    title 'VM'
  }
}

deployment {
  home = deploymentNode koti {
    title 'Koti (kotiverkko)'
    description 'Fyysiset laitteet kotiverkossa'

    gateway = instanceOf koti.gateway
    shelly = instanceOf koti.shelly
    desk = instanceOf koti.desk
  }

  server = deploymentNode vm {
    title 'VM (Hetzner)'
    technology 'Docker Compose'

    ha = instanceOf koti.ha
    mqtt = instanceOf koti.mqtt
    heating = instanceOf koti.heating
    wilmaService = instanceOf koti.wilmaService
  }
}

views {

  deployment view deployment {
    title 'Level 4 — Deployment (Code-tason sijaan: fyysinen/ajonaikainen sijainti)'
    description '
      Missä kukin container oikeasti pyörii: koti-verkossa vai VM:llä.
      Code-taso (luokka-/moduulikaavio) jätetty tarkoituksella pois — se
      vanhenisi heti eikä toisi arvoa tälle projektille.
    '
    include
      home, home.*,
      server, server.*,
      wilma, anthropic, spotHinta, telegram,
      rami, perhe
  }

}
