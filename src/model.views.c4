views {

  view index {
    title 'Level 1 — System Context'
    description '
      Yksi systeemi ("koti"), sen käyttäjät ja aidosti ulkopuoliset järjestelmät.
      Ei sisällä sisäisiä palveluja, MQTT:tä, VM:ää tai laitteita — ne ovat
      Level 2:lla (containers-näkymä) ja Level 4:llä (deployment.c4).
    '
    include
      koti,
      rami,
      perhe,
      wilma,
      anthropic,
      spotHinta,
      telegram
  }

  view containers of koti {
    title 'Level 2 — Container: koti'
    description 'koti-systeemin sisältä auki purettuna: mistä toimivista osista se koostuu.'
    include
      *,
      rami,
      perhe,
      wilma,
      anthropic,
      spotHinta,
      telegram
  }

  view heatingComponents of koti.heating {
    title 'Level 3 — Component: Lämmityksen ohjain'
    include
      *,
      koti.mqtt,
      spotHinta
  }

  view wilmaComponents of koti.wilmaService {
    title 'Level 3 — Component: Wilma-muistutuspalvelu'
    include
      *,
      koti.mqtt,
      wilma,
      anthropic
  }

}
